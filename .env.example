# Server Configuration
PORT=5000
NODE_ENV=development

# AI Service Configuration
# Set your AI API Key here (supports Google Gemini, OpenAI, or any OpenAI-compatible provider)
AI_PROVIDER=gemini
# Leave blank to use the built-in heuristic engine without an external AI provider.
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# For OpenAI or OpenAI-compatible (Groq, OpenRouter, Ollama, DeepSeek, etc.):
# AI_PROVIDER=openai
# AI_API_KEY=your_openai_or_groq_key
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# Security & Upload Configuration
MAX_FILE_SIZE=10485760
CORS_ORIGIN=http://localhost:5173
